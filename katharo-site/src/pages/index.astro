---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';

import surroundSrc from '../../assets/plates/surround.png';
import doorLeftSrc from '../../assets/plates/door-left.png';
import doorRightSrc from '../../assets/plates/door-right.png';
import intercomSrc from '../../assets/plates/intercom.png';
import buttonSrc from '../../assets/plates/intercom-button.png';
import floorSrc from '../../assets/plates/floor.png';
import lobbySrc from '../../assets/motion/lobby.png';
import tileSrc from '../../assets/textures/terrazzo-tile.png';

const webp = (src: ImageMetadata, width: number) => getImage({ src, width, format: 'webp', quality: 82 });
const [surround, doorLeft, doorRight, intercom, button, floor, lobby, lobbyWide] = await Promise.all([
  webp(surroundSrc, 2688), webp(doorLeftSrc, 960), webp(doorRightSrc, 840), webp(intercomSrc, 820),
  webp(buttonSrc, 120), webp(floorSrc, 2688), webp(lobbySrc, 1400), webp(lobbySrc, 1985),
]);
const tile = await webp(tileSrc, 1000);

const spaces = [
  { id: 'locuinta', value: 'Locuință', label: 'Locuință' },
  { id: 'apartament', value: 'Apartament', label: 'Apartament' },
  { id: 'birou', value: 'Birou', label: 'Birou' },
  { id: 'depozit', value: 'Depozit', label: 'Depozit' },
  { id: 'renovare', value: 'După renovare', label: 'După renovare' },
];

const rules = [
  { icon: 'doc-check', label: 'Preț fix, în scris', detail: 'Primești prețul în scris înainte de lucrare. Nu se schimbă în ziua vizitei.' },
  { icon: 'team', label: 'Aceeași echipă', detail: 'Clienții recurenți au aceeași echipă la fiecare vizită.' },
  { icon: 'contract', label: 'Factură și contract', detail: 'Pentru persoane fizice și firme, la fiecare client.' },
  { icon: 'child-paw', label: 'Produse sigure pentru copii și animale', detail: 'Alegem produse potrivite pentru casele cu copii și animale de companie.' },
] as const;

const directory = [
  { name: 'Locuințe și apartamente', text: 'Curățenie generală sau de întreținere, cameră cu cameră.' },
  { name: 'Birouri', text: 'Spații de lucru, săli de ședință, bucătării și grupuri sanitare.' },
  { name: 'Depozite și hale', text: 'Spații mari de depozitare și producție.' },
  { name: 'Spații comerciale', text: 'Magazine, showroomuri și spații deschise publicului.' },
  { name: 'După renovare', text: 'Praf de construcție, resturi de vopsea și adeziv, după constructor.' },
];

const faq = [
  { q: 'Cum se stabilește prețul?', a: 'Ne spui tipul spațiului, suprafața și ce ai nevoie. Îți trimitem un preț fix, în scris, înainte de lucrare. Prețul nu se schimbă în ziua vizitei.' },
  { q: 'Vine aceeași echipă de fiecare dată?', a: 'Da. Clienții recurenți au aceeași echipă la fiecare vizită, oameni care le cunosc deja spațiul.' },
  { q: 'Emiteți factură și contract?', a: 'Da, pentru fiecare client, fie persoană fizică, fie firmă.' },
  { q: 'Ce produse folosiți?', a: 'Produse sigure pentru casele cu copii și animale de companie.' },
  { q: 'Ce tipuri de spații curățați?', a: 'Locuințe, apartamente, birouri, depozite, hale, spații comerciale și spații după renovare.' },
];
---
<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Katharo Cleaning · Curățenie pentru case, birouri și depozite</title>
  <meta name="description" content="Curățenie pentru locuințe, birouri și depozite. Preț fix, în scris, înainte de lucrare. Aceeași echipă la fiecare vizită. Factură și contract." />
  <meta property="og:title" content="Katharo Cleaning" />
  <meta property="og:description" content="Curat, ca la prima intrare. Preț fix, în scris, înainte de lucrare." />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#100d0a" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/work-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={surround.src} as="image" />
</head>
<body>
  <a class="skip" href="#continut">Sari la conținut</a>

  <header class="site-head" id="head">
    <div class="head-inner">
      <a class="brand" href="#top" aria-label="Katharo Cleaning, începutul paginii"><Logo /></a>
      <nav aria-label="Principal">
        <ul>
          <li><a href="#servicii">Servicii</a></li>
          <li><a href="#cum-lucram">Cum lucrăm</a></li>
          <li><a href="#reguli">Regulile casei</a></li>
          <li><a href="#intrebari">Întrebări</a></li>
        </ul>
      </nav>
      <a class="head-cta" href="#oferta">Solicită o ofertă</a>
    </div>
  </header>

  <main id="continut">
    <!-- The entrance: doors open into the lobby as the visitor scrolls. -->
    <section class="stage-track" id="top" aria-label="Intrarea Katharo">
      <div class="stage" style={`--floor-img: url(${floor.src}); --tile: url(${tile.src})`}>
        <div class="frame" id="frame">
          <img class="plate surround" src={surround.src} alt="" width="2688" height="1100" fetchpriority="high" />
          <div class="opening" aria-hidden="true">
            <img class="lobby" src={lobby.src} alt="" width="1240" height="880" loading="eager" />
          </div>
          <img class="plate door door-l" src={doorLeft.src} alt="" width="640" height="880" />
          <span class="mullion" aria-hidden="true"></span>
          <img class="plate door door-r" src={doorRight.src} alt="" width="556" height="880" />

          <div class="glass-copy">
            <span class="frost" aria-hidden="true"></span>
            <h1>Curat, ca la<br />prima intrare.</h1>
            <span class="rule headline-rule" aria-hidden="true"><i></i><Icon name="sparkle" class="star" /><i></i></span>
            <p class="subline">Preț fix, în scris, înainte de lucrare.<br />Aceeași echipă la fiecare vizită.</p>
          </div>

          <form class="intercom js-intercom" id="intercom" novalidate aria-labelledby="intercom-title">
            <img class="plate intercom-plate" src={intercom.src} alt="" width="548" height="930" />
            <span class="ic-patch" aria-hidden="true" style={`background-image: url(${intercom.src})`}></span><span class="ic-divider" aria-hidden="true"></span>
            <p class="ic-title" id="intercom-title">Katharo<span>Cleaning</span></p>
            <fieldset class="ic-options">
              <legend class="sr">Tipul spațiului</legend>
              {spaces.map((s, i) => (
                <label class={`ic-opt ic-opt-${i + 1}`}>
                  <input type="radio" name="tip" value={s.value} required />
                  <img src={button.src} alt="" width="64" height="64" />
                  <span>{s.label}</span>
                </label>
              ))}
            </fieldset>
            <label class="ic-area-label" for="ic-area">Suprafață (m²)</label>
            <input class="ic-area" id="ic-area" name="suprafata" type="number" inputmode="numeric" min="5" max="100000" />
            <button class="ic-call" type="submit"><Icon name="phone" class="ic-phone" />Cere oferta fixă</button>
            <p class="ic-msg" id="ic-msg" role="status" aria-live="polite"></p>
          </form>

          <div class="floor-wrap" id="reguli">
            <img class="plate floor" src={floor.src} alt="" width="2688" height="420" />
            <h2 class="rules-title">Regulile casei</h2>
            <span class="rule rules-rule" aria-hidden="true"><i></i><Icon name="sparkle" class="star" /><i></i></span>
            <ul class="rules">
              {rules.map((r, i) => (
                <li class={`rule-item rule-${i + 1}`}>
                  <span class="rule-icon"><Icon name={r.icon} stroke={1.9} /></span>
                  <span class="rule-label">{r.label}</span>
                </li>
              ))}
            </ul>
            <span class="sep sep-1" aria-hidden="true"></span><span class="sep sep-2" aria-hidden="true"></span><span class="sep sep-3" aria-hidden="true"></span>
          </div>
        </div>
        <form class="m-starter js-intercom" novalidate aria-label="Cere oferta fixă">
          <div class="ms-f"><label for="ms-type">Tip spațiu</label>
            <select id="ms-type" name="tip"><option value="">Alege</option>{spaces.map((s) => <option value={s.value}>{s.label}</option>)}</select></div>
          <div class="ms-f"><label for="ms-area">Suprafață (m²)</label><input id="ms-area" name="suprafata" type="number" inputmode="numeric" min="5" max="100000" /></div>
          <button class="ms-call" type="submit"><Icon name="phone" class="ms-phone" />Cere oferta fixă</button>
          <p class="ic-msg ms-msg" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <!-- Phones: the intercom and the house rules, below the entrance. -->
    <section class="m-entry" aria-label="Cere oferta și regulile casei" style={`--floor-img: url(${floor.src}); --tile: url(${tile.src})`}>
      <form class="intercom intercom-m js-intercom" id="intercom-m" novalidate aria-labelledby="intercom-title-m">
            <img class="plate intercom-plate" src={intercom.src} alt="" width="548" height="930" />
            <span class="ic-patch" aria-hidden="true" style={`background-image: url(${intercom.src})`}></span><span class="ic-divider" aria-hidden="true"></span>
            <p class="ic-title" id="intercom-title-m">Katharo<span>Cleaning</span></p>
            <fieldset class="ic-options">
              <legend class="sr">Tipul spațiului</legend>
              {spaces.map((s, i) => (
                <label class={`ic-opt ic-opt-${i + 1}`}>
                  <input type="radio" name="tip-m" value={s.value} required />
                  <img src={button.src} alt="" width="64" height="64" />
                  <span>{s.label}</span>
                </label>
              ))}
            </fieldset>
            <label class="ic-area-label" for="ic-area-m">Suprafață (m²)</label>
            <input class="ic-area" id="ic-area-m" name="suprafata" type="number" inputmode="numeric" min="5" max="100000" />
            <button class="ic-call" type="submit"><Icon name="phone" class="ic-phone" />Cere oferta fixă</button>
            <p class="ic-msg" id="ic-msg-m" role="status" aria-live="polite"></p>
          </form>
      <h2 class="m-rules-title">Regulile casei</h2>
      <ul class="m-rules">
        {rules.map((r) => (<li><span class="rule-icon"><Icon name={r.icon} /></span><span><strong>{r.label}</strong><small>{r.detail}</small></span></li>))}
      </ul>
    </section>

    <!-- Inside: the lobby tenant directory lists what Katharo cleans. -->
    <section class="lobby-sec" id="servicii" aria-labelledby="servicii-h">
      <img class="lobby-bg" src={lobbyWide.src} alt="" width="1985" height="1408" loading="lazy" />
      <div class="wrap lobby-inner">
        <div class="board">
          <h2 id="servicii-h">Ce curățăm</h2>
          <p class="board-sub">Locatari</p>
          <ol class="board-list">
            {directory.map((d) => (
              <li><Icon name="sparkle" class="board-star" /><div><h3>{d.name}</h3><p>{d.text}</p></div></li>
            ))}
          </ol>
        </div>
        <p class="lobby-note">Și orice alt spațiu care are nevoie de curățenie. Spune-ne ce ai nevoie și îți trimitem prețul.</p>
      </div>
    </section>

    <section class="cream-sec steps-sec" id="cum-lucram" aria-labelledby="cum-h" style={`--floor-img: url(${floor.src}); --tile: url(${tile.src})`}>
      <div class="wrap">
        <h2 id="cum-h" class="cream-h">Cum lucrăm</h2>
        <span class="rule deco-rule" aria-hidden="true"><i></i><Icon name="sparkle" class="star" /><i></i></span>
        <ol class="steps">
          <li><span class="step-n" aria-hidden="true">1</span><h3>Ne spui ce ai nevoie</h3><p>Tipul spațiului, suprafața și ce trebuie curățat.</p></li>
          <li><span class="step-n" aria-hidden="true">2</span><h3>Primești prețul fix, în scris</h3><p>Înainte de lucrare. Prețul nu se schimbă în ziua vizitei.</p></li>
          <li><span class="step-n" aria-hidden="true">3</span><h3>Venim cu aceeași echipă</h3><p>Pentru clienții recurenți, de fiecare dată aceiași oameni. Cu factură și contract.</p></li>
        </ol>
      </div>
    </section>

    <section class="cream-sec faq-sec" id="intrebari" aria-labelledby="faq-h">
      <div class="wrap faq-grid">
        <div><h2 id="faq-h" class="cream-h">Întrebări</h2><span class="rule deco-rule" aria-hidden="true"><i></i><Icon name="sparkle" class="star" /><i></i></span></div>
        <div class="faq">
          {faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<span class="pm" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="desk-sec" id="oferta" aria-labelledby="oferta-h">
      <div class="wrap desk-grid">
        <div class="desk-intro">
          <h2 id="oferta-h">Solicită o ofertă</h2>
          <span class="rule deco-rule gold" aria-hidden="true"><i></i><Icon name="sparkle" class="star" /><i></i></span>
          <p>Completează câteva detalii. Îți trimitem un preț fix, în scris, înainte de lucrare.</p>
        </div>
        <form class="desk" id="desk" novalidate>
          <div class="f"><label for="d-name">Nume</label><input id="d-name" name="nume" autocomplete="name" required /><p class="err" id="e-name"></p></div>
          <div class="f"><label for="d-phone">Telefon</label><input id="d-phone" name="telefon" type="tel" autocomplete="tel" inputmode="tel" required /><p class="err" id="e-phone"></p></div>
          <div class="f full"><label for="d-email">Email <span>(opțional)</span></label><input id="d-email" name="email" type="email" autocomplete="email" /><p class="err" id="e-email"></p></div>
          <div class="f"><label for="d-type">Tip spațiu</label>
            <select id="d-type" name="tip" required>
              <option value="">Alege</option>
              {spaces.map((s) => <option value={s.value}>{s.label}</option>)}
              <option value="Spațiu comercial">Spațiu comercial</option>
              <option value="Altul">Altul</option>
            </select><p class="err" id="e-type"></p></div>
          <div class="f"><label for="d-area">Suprafață (m²)</label><input id="d-area" name="suprafata" type="number" inputmode="numeric" min="5" max="100000" /><p class="err" id="e-area"></p></div>
          <div class="f full"><label for="d-city">Localitate</label><input id="d-city" name="localitate" autocomplete="address-level2" required /><p class="err" id="e-city"></p></div>
          <div class="f full"><label for="d-msg">Detalii <span>(opțional)</span></label><textarea id="d-msg" name="detalii" rows="4"></textarea></div>
          <div class="desk-foot full">
            <small>Trimițând cererea ești de acord cu <a href="/confidentialitate">politica de confidențialitate</a>.</small>
            <button type="submit" class="desk-send">Trimite cererea <Icon name="arrow" class="arr" /></button>
          </div>
          <p class="desk-status full" id="desk-status" role="status" aria-live="polite" hidden></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <a class="foot-brand" href="#top" aria-label="Katharo Cleaning, începutul paginii"><Logo /></a>
      <ul class="foot-nav">
        <li><a href="#servicii">Servicii</a></li><li><a href="#cum-lucram">Cum lucrăm</a></li>
        <li><a href="#reguli">Regulile casei</a></li><li><a href="#intrebari">Întrebări</a></li>
        <li><a href="#oferta">Solicită o ofertă</a></li>
      </ul>
    </div>
    <div class="wrap foot-legal">
      <span>© {new Date().getFullYear()} Katharo Cleaning</span>
      <span><a href="/confidentialitate">Confidențialitate</a> · <a href="/termeni">Termeni</a></span>
    </div>
  </footer>

  <script>
    // Where quote requests are sent. Set to your form backend (e.g. Formspree) before launch.
    const FORM_ENDPOINT = '';

    // Doors open with scroll: --open 0→1, then the view moves into the lobby: --zoom 0→1.
    const track = document.querySelector<HTMLElement>('.stage-track')!;
    const root = document.documentElement;
    const head = document.getElementById('head')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    function update() {
      ticking = false;
      const r = track.getBoundingClientRect();
      const span = Math.max(1, track.offsetHeight - innerHeight);
      const p = reduce.matches ? 0 : clamp(-r.top / span);
      root.style.setProperty('--open', ease(clamp(p / 0.55)).toFixed(4));
      root.style.setProperty('--zoom', ease(clamp((p - 0.45) / 0.55)).toFixed(4));
      head.classList.toggle('solid', scrollY > 8);
    }
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();

    // Intercom: pick a space and m², then continue at the concierge desk with them filled in.
    document.querySelectorAll<HTMLFormElement>('.js-intercom').forEach((ic) => {
      const msg = ic.querySelector<HTMLElement>('.ic-msg')!;
      ic.addEventListener('submit', (e) => {
        e.preventDefault();
        const picked = ic.querySelector<HTMLInputElement>('input[type=radio]:checked') ?? ic.querySelector<HTMLSelectElement>('select');
        const area = ic.querySelector<HTMLInputElement>('input[type=number]')!.value;
        if (!picked || !picked.value) { msg.textContent = 'Alege tipul spațiului.'; return; }
        msg.textContent = '';
        (document.getElementById('d-type') as HTMLSelectElement).value = picked.value;
        if (area) (document.getElementById('d-area') as HTMLInputElement).value = area;
        document.getElementById('oferta')!.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth' });
        setTimeout(() => (document.getElementById('d-name') as HTMLInputElement).focus({ preventScroll: true }), reduce.matches ? 0 : 700);
      });
    });

    // Concierge desk form.
    const desk = document.getElementById('desk') as HTMLFormElement;
    const status = document.getElementById('desk-status')!;
    const rules: Record<string, [string, (v: string) => boolean, string]> = {
      name: ['d-name', (v) => v.trim().length >= 2, 'Scrie-ne numele tău.'],
      phone: ['d-phone', (v) => /^(\+?40|0)\s?7\d{2}[\s.]?\d{3}[\s.]?\d{3}$/.test(v.trim()) || /^\+?\d[\d\s]{8,14}$/.test(v.trim()), 'Introdu un număr de telefon valid, de exemplu 0722 123 456.'],
      email: ['d-email', (v) => !v.trim() || /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()), 'Adresa de email nu este completă.'],
      type: ['d-type', (v) => !!v, 'Alege tipul spațiului.'],
      area: ['d-area', (v) => !v || (+v >= 5 && +v <= 100000), 'Suprafața trebuie să fie între 5 și 100000 m².'],
      city: ['d-city', (v) => v.trim().length >= 2, 'Spune-ne localitatea.'],
    };
    function check(k: string) {
      const [id, ok, msg] = rules[k];
      const el = document.getElementById(id) as HTMLInputElement;
      const bad = !ok(el.value);
      el.setAttribute('aria-invalid', String(bad));
      const err = document.getElementById('e-' + k)!;
      err.textContent = bad ? msg : '';
      bad ? el.setAttribute('aria-describedby', 'e-' + k) : el.removeAttribute('aria-describedby');
      return !bad;
    }
    Object.keys(rules).forEach((k) => document.getElementById(rules[k][0])!.addEventListener('blur', (e) => { if ((e.target as HTMLInputElement).value) check(k); }));
    desk.addEventListener('submit', async (e) => {
      e.preventDefault();
      const bad = Object.keys(rules).filter((k) => !check(k));
      if (bad.length) { (document.getElementById(rules[bad[0]][0]) as HTMLElement).focus(); return; }
      status.hidden = false; status.className = 'desk-status full';
      if (!FORM_ENDPOINT) {
        status.textContent = 'Formularul nu este încă conectat, așa că cererea nu a fost trimisă. Datele sunt complete și corecte.';
        return;
      }
      const btn = desk.querySelector('button')!; btn.disabled = true;
      try {
        const res = await fetch(FORM_ENDPOINT, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(desk) });
        if (!res.ok) throw new Error(String(res.status));
        status.classList.add('ok');
        status.textContent = 'Am primit cererea. Îți trimitem prețul fix, în scris.';
        desk.reset();
      } catch {
        status.textContent = 'Cererea nu a putut fi trimisă. Verifică conexiunea și încearcă din nou.';
      } finally { btn.disabled = false; }
    });
  </script>
</body>
</html>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---------- Header on the lintel ---------- */
  .site-head {
    position: fixed; inset: 0 0 auto; z-index: 40; overflow: hidden;
    padding-top: env(safe-area-inset-top);
    transition: background-color 500ms var(--ease-out), box-shadow 500ms var(--ease-out);
  }
  .site-head.solid { background: rgba(16, 13, 10, 0.92); box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.6); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .site-head { --hw: var(--fw); }
  .head-inner { position: relative; width: var(--fw); left: 50%; margin-left: calc(var(--fw) / -2); height: calc(var(--fw) * 0.052); min-height: 64px; container-type: inline-size; }
  .brand { position: absolute; left: 11.76cqw; top: 0.5cqw; width: 17.04cqw; height: 3.57cqw; min-width: 150px; color: var(--gold); }
  .site-head nav ul { list-style: none; margin: 0; padding: 0; }
  .site-head nav li { position: absolute; top: 1.86cqw; }
  .site-head nav li:nth-child(1) { left: 37.05cqw; } .site-head nav li:nth-child(2) { left: 43.6cqw; }
  .site-head nav li:nth-child(3) { left: 52.53cqw; } .site-head nav li:nth-child(4) { left: 62.05cqw; }
  .site-head nav a {
    text-decoration: none; color: #eadfca; font-size: max(13px, 0.93cqw); font-weight: 500; letter-spacing: 0; line-height: 1.4; white-space: nowrap;
    transition: color 300ms var(--ease-out);
  }
  .site-head nav a:hover { color: var(--gold-hi); }
  .head-cta {
    position: absolute; left: 82.07cqw; top: 1.12cqw; width: 11.98cqw; height: 2.68cqw; min-height: 36px;
    display: grid; place-items: center; border: 1px solid var(--gold); border-radius: 999px;
