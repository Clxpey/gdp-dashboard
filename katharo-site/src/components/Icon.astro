---
// Line icons, one stroke weight, drawn for this site (24px grid, 1.5 stroke).
interface Props { name: 'doc-check' | 'team' | 'contract' | 'child-paw' | 'phone' | 'arrow' | 'sparkle'; class?: string; stroke?: number }
const { name, class: cls, stroke = 1.4 } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'doc-check' && (<>
    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h5" /><path d="M14 3v4h4" /><path d="M18 7v5.5" />
    <path d="M8.5 9.5h6M8.5 13h4.5" /><path d="m13.8 18.3 2.2 2.2 4-4.5" />
  </>)}
  {name === 'team' && (<>
    <circle cx="12" cy="8.2" r="2.6" /><path d="M7.4 18.8c.6-2.7 2.4-4.2 4.6-4.2s4 1.5 4.6 4.2" />
    <circle cx="5.6" cy="10.4" r="2" /><path d="M2.4 18c.4-2 1.6-3.1 3.3-3.1" />
    <circle cx="18.4" cy="10.4" r="2" /><path d="M21.6 18c-.4-2-1.6-3.1-3.3-3.1" />
  </>)}
  {name === 'contract' && (<>
    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" />
    <path d="M8.5 11.5h7M8.5 14.5h4.5" /><path d="M8.6 18.3c.8-1 1.5-1 1.9 0s1.1 1 1.9 0 1.5-1 2.1.1" />
  </>)}
  {name === 'child-paw' && (<>
    <circle cx="9" cy="11.5" r="5.6" /><path d="M6.6 6.8c.9-1.6 2.6-2 4.2-1.2" />
    <path d="M7 13.3c.5.7 1.2 1.1 2 1.1s1.5-.4 2-1.1" /><path d="M7.3 10.6h.01M10.7 10.6h.01" stroke-width="2.2" />
    <path d="M18.3 21.2c-1.4 0-2.4-.8-2.4-1.8 0-1.2 1.1-2.3 2.4-2.3s2.4 1.1 2.4 2.3c0 1-1 1.8-2.4 1.8z" />
    <path d="M15.6 15.6h.01M17.4 14.4h.01M19.3 14.4h.01M21.1 15.6h.01" stroke-width="2.4" />
  </>)}
  {name === 'phone' && (
    <path d="M6.2 3.5h3l1.5 4.2-2.1 1.3a11.5 11.5 0 0 0 6.4 6.4l1.3-2.1 4.2 1.5v3a1.9 1.9 0 0 1-2 1.9A16.5 16.5 0 0 1 4.3 5.5a1.9 1.9 0 0 1 1.9-2z" />
  )}
  {name === 'arrow' && (<path d="M4 12h16M14 6l6 6-6 6" />)}
  {name === 'sparkle' && (<path d="M12 2.5c.5 5.2 4.3 9 9.5 9.5-5.2.5-9 4.3-9.5 9.5-.5-5.2-4.3-9-9.5-9.5 5.2-.5 9-4.3 9.5-9.5z" fill="currentColor" stroke="none" />)}
</svg>
