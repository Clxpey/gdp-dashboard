---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} · Katharo Cleaning</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <main class="wrap plain">
    <a class="plain-brand" href="/" aria-label="Katharo Cleaning, pagina principală"><Logo /></a>
    <slot />
    <p class="plain-back"><a href="/">Înapoi la pagina principală</a></p>
  </main>
</body>
</html>
<style>
  .plain { max-width: 760px; padding-block: 56px 96px; }
  .plain-brand { display: block; width: 200px; height: 46px; color: var(--gold); margin-bottom: 56px; }
  .plain :global(h1) { font-size: 44px; line-height: 1.1; color: var(--gold-hi); margin-bottom: 24px; }
  .plain :global(h2) { font-size: 22px; margin: 36px 0 10px; color: var(--on-lacquer); }
  .plain :global(p), .plain :global(li) { color: var(--on-lacquer-muted); }
  .plain :global(.note) { border: 1px solid var(--lacquer-line); border-radius: 6px; padding: 14px 18px; color: var(--gold-hi); font-size: 15px; }
  .plain-back { margin-top: 48px; }
  .plain-back a { color: var(--gold-hi); }
</style>
